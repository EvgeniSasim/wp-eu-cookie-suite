{
  "name": "wp-eu-cookie-suite",
  "private": true,
  "scripts": {
    "build": "esbuild assets/js/src/cookieconsent.js --bundle --minify --outfile=assets/js/cookieconsent.bundle.js --loader:.css=css --outdir=assets/js && mv assets/js/cookieconsent.bundle.css assets/css/cookieconsent.bundle.css",
    "dev": "esbuild assets/js/src/cookieconsent.js --bundle --outfile=assets/js/cookieconsent.bundle.js --watch"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "vanilla-cookieconsent": "^3.0.0"
  }
}
